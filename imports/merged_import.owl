AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/HP_0033109> "Abnormal circulating non-proteinogenic amino acid concentration")
SubClassOf(<http://purl.obolibrary.org/obo/HP_0033109> <http://purl.obolibrary.org/obo/HP_0003112>)

