AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_50904> "allergen")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_50904> <http://purl.obolibrary.org/obo/CHEBI_52209>)

