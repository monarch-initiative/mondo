AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_50949> "serotonin uptake inhibitor")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_50949> <http://purl.obolibrary.org/obo/CHEBI_48278>)

