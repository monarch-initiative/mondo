# Class: <http://purl.obolibrary.org/obo/MFOMD_0000001> (mental disease)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MFOMD_0000001> "A disease which is a disposition to undergo pathological mental processes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MFOMD_0000001> "mental disease")
SubClassOf(<http://purl.obolibrary.org/obo/MFOMD_0000001> <http://purl.obolibrary.org/obo/BFO_0000016>)

# Class: <http://purl.obolibrary.org/obo/MFOMD_0000004> (mental disorder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MFOMD_0000004> "Clinically significant behavioural and/or cognitive pathology.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MFOMD_0000004> "mental disorder")
SubClassOf(<http://purl.obolibrary.org/obo/MFOMD_0000004> <http://purl.obolibrary.org/obo/MFOMD_0000025>)

# Class: <http://purl.obolibrary.org/obo/MFOMD_0000013> (depressed mood episode)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MFOMD_0000013> "A depressed mood episode is a pathological mental process characterised by persistent feelings of sadness, anxiety, guilt, anger, isolation or hopelessness and other negative valence emotions, disturbances in sleep and appetite, fatigue, loss of interest in usually enjoyable activities and morbid or suicidal ideation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MFOMD_0000013> "depressed mood episode"@en)
SubClassOf(<http://purl.obolibrary.org/obo/MFOMD_0000013> <http://purl.obolibrary.org/obo/MFOMD_0000024>)

# Class: <http://purl.obolibrary.org/obo/MFOMD_0000024> (pathological mental process)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MFOMD_0000024> "pathological mental process")
SubClassOf(<http://purl.obolibrary.org/obo/MFOMD_0000024> <http://purl.obolibrary.org/obo/BFO_0000015>)
SubClassOf(<http://purl.obolibrary.org/obo/MFOMD_0000024> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/MF#manifestationOf> <http://purl.obolibrary.org/obo/MFOMD_0000004>))

# Class: <http://purl.obolibrary.org/obo/MFOMD_0000025> (mental disease course)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/MFOMD_0000025> "A disease course of a mental disease.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/MFOMD_0000025> "mental disease course")
SubClassOf(<http://purl.obolibrary.org/obo/MFOMD_0000025> <http://purl.obolibrary.org/obo/BFO_0000015>)
