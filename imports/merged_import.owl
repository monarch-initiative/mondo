AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_50905> "teratogenic agent")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_50905> <http://purl.obolibrary.org/obo/CHEBI_52209>)

