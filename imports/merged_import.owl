AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_35523> "An agent that causes an increase in the expansion of a bronchus or bronchial tubes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35523> "bronchodilator agent")
