# Class: <http://purl.obolibrary.org/obo/FOODON_03420167> (fruit part)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420167> "The fleshy fruit of any plant. *FRUIT* includes vegetables berries and pods as well. The bulk of a fruit is its fleshy part, which is covered by a peel (skin) and which encloses a core, pit or seeds."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420167> "fruit part"@en)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420168> (bone or shell)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/FOODON_03420168> "Bone (endoskeleton) or shell (exoskeleton) of animals, or any part thereof."@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03420168> "bone or shell"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03420168> <http://purl.obolibrary.org/obo/FOODON_03420122>)

# Class: <http://purl.obolibrary.org/obo/FOODON_03420174> (obsolete: part of plant)

