AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_35524> "A drug that mimics the effects of stimulating postganglionic adrenergic sympathetic nerves. Included in this class are drugs that directly stimulate adrenergic receptors and drugs that act indirectly by provoking the release of adrenergic transmitters.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35524> "sympathomimetic agent")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_35524> <http://purl.obolibrary.org/obo/CHEBI_37962>)

