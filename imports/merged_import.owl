AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35526> "hypoglycemic agent")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_35526> <http://purl.obolibrary.org/obo/CHEBI_23888>)

