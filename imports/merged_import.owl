AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_35406> "An oxoanion is an anion derived from an oxoacid by loss of hydron(s) bound to oxygen.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35406> "oxoanion")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_35406> <http://purl.obolibrary.org/obo/CHEBI_25741>)
