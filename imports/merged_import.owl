AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_35471> "A loosely defined grouping of drugs that have effects on psychological function.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35471> "psychotropic drug")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_35471> <http://purl.obolibrary.org/obo/CHEBI_35470>)

