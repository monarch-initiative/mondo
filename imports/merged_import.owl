AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/FOODON_03412702> "kid (goat)"@en)
SubClassOf(<http://purl.obolibrary.org/obo/FOODON_03412702> <http://purl.obolibrary.org/obo/NCBITaxon_9925>)

