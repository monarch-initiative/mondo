AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35441> "antiinfective agent")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_35441> <http://purl.obolibrary.org/obo/CHEBI_23888>)

