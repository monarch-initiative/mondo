TransitiveObjectProperty(<http://purl.obolibrary.org/obo/RO_0002158>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002159> (serially homologous to)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002159> "serially homologous to")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002159> <http://purl.obolibrary.org/obo/RO_0002320>)
