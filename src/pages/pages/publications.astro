---
import Page from "../../layouts/Page.astro";
import Authors from "../../components/Authors.astro";
import { loadYaml } from "../../lib/data";

const pubs = loadYaml<any>("publications.yaml");
// Newest first. Manuscripts only record a year, so same-year items keep their order in the data file.
// Blogs sort by full date; undated posts go last.
const manuscripts = [...pubs.manuscripts].sort((a: any, b: any) => (b.year ?? 0) - (a.year ?? 0));
const blogTime = (d?: string) => (d ? Date.parse(d) || 0 : 0);
const blogs = [...pubs.blogs].sort((a: any, b: any) => blogTime(b.date) - blogTime(a.date));
const c = pubs.cite;
const citation = `${c.authors}. ${c.title}. ${c.venue}. ${c.year}. https://doi.org/${c.doi}`;
---
<Page title="Publications" eyebrow="Publications & Talks" intro="Peer-reviewed papers, preprints and blog posts about the Mondo Disease Ontology." wide>
  <section class="cite card">
    <div>
      <span class="pill alt">How to cite Mondo</span>
      <h2><a href={c.url}>{c.title}</a></h2>
      <p class="venue"><em>{c.venue}</em> ({c.year}) · doi:{c.doi}</p>
      <Authors authors={c.authors} show={8} />
    </div>
    <div class="cite-actions">
      <a class="btn btn-solid" href={c.url}>Read the paper</a>
      <button class="btn btn-outline" id="copy" data-cite={citation}>Copy citation</button>
    </div>
  </section>

  <section class="tabs-wrap" aria-label="Publications and blogs">
    <div class="tabs" role="tablist" aria-label="Publication types" hidden>
      <button type="button" role="tab" id="tab-manuscripts" aria-controls="manuscripts" aria-selected="true">Manuscripts <span class="n">{manuscripts.length}</span></button>
      <button type="button" role="tab" id="tab-blogs" aria-controls="blogs" aria-selected="false" tabindex="-1">Blogs <span class="n">{blogs.length}</span></button>
    </div>

    <div class="panel" id="manuscripts" role="tabpanel" aria-labelledby="tab-manuscripts">
      <h2 class="panel-title">Manuscripts</h2>
      <ol class="pubs">
        {manuscripts.map((p: any) => (
          <li>
            <span class="year">{p.year}</span>
            <div>
              <h3><a href={p.url}>{p.title}</a></h3>
              <p class="venue"><em>{p.venue}</em></p>
              <Authors authors={p.authors} />
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="panel" id="blogs" role="tabpanel" aria-labelledby="tab-blogs">
      <h2 class="panel-title">Blogs</h2>
      <ul class="blogs">
        {blogs.map((b: any) => (
          <li>
            <a href={b.url}>{b.title}</a>
            <span>{b.authors}{b.date ? ` · ${b.date}` : ""}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Page>

<style>
  .cite { margin: 48px 0 0; display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; border: 2px solid var(--teal); }
  .cite h2 { font-size: 1.4rem; margin: 12px 0 4px; }
  .cite h2 a { color: var(--ink); text-decoration: none; }
  .cite h2 a:hover { color: var(--teal-deep); }
  .cite-actions { display: flex; flex-direction: column; gap: 10px; }
  .cite-actions button { font: inherit; cursor: pointer; background: none; }
  @media (max-width: 760px) { .cite { grid-template-columns: 1fr; } .cite-actions { flex-direction: row; flex-wrap: wrap; } }
  .venue { margin: 2px 0 0; font-size: 0.92rem; }
  .tabs-wrap { padding: 44px 0 72px; }
  .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin-bottom: 8px; }
  .tabs [role="tab"] { font: inherit; font-weight: 600; font-size: 1.05rem; color: var(--ink-soft); background: none; border: 0; border-bottom: 3px solid transparent; margin-bottom: -1px; padding: 10px 16px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
  .tabs [role="tab"]:hover { color: var(--ink); }
  .tabs [role="tab"][aria-selected="true"] { color: var(--teal-deep); border-bottom-color: var(--teal-deep); }
  .tabs [role="tab"]:focus-visible { outline: 3px solid var(--teal-deep); outline-offset: -3px; border-radius: 4px 4px 0 0; }
  .tabs .n { font-size: 0.8rem; font-weight: 500; background: var(--teal-wash); color: var(--teal-deep); border-radius: 999px; padding: 1px 8px; }
  .panel-title { font-size: 1.5rem; margin: 0 0 4px; }
  .panel + .panel { margin-top: 40px; }
  /* With tabs active, the tab label replaces the visible panel heading. */
  .tabs-ready .panel-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .tabs-ready .panel + .panel { margin-top: 0; }
  .panel:focus-visible { outline: 3px solid var(--teal-deep); outline-offset: 4px; }
  .pubs { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .pubs li { display: grid; grid-template-columns: 56px 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .pubs .year { font-weight: 600; color: var(--teal-deep); }
  .pubs h3 { font-size: 1rem; margin: 0; font-weight: 500; }
  .pubs h3 a { color: var(--ink); text-decoration: none; }
  .pubs h3 a:hover { color: var(--teal-deep); text-decoration: underline; }
  .authors { font-size: 0.88rem; color: var(--ink-muted); margin: 6px 0 0; }
  .blogs { list-style: none; margin: 0; padding: 0; }
  .blogs li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .blogs a { font-weight: 500; }
  .blogs span { display: block; font-size: 0.86rem; color: var(--ink-muted); }
</style>

<script>
  const b = document.getElementById("copy") as HTMLButtonElement | null;
  b?.addEventListener("click", async () => {
    try { await navigator.clipboard.writeText(b.dataset.cite!); b.textContent = "Copied!"; }
    catch { b.textContent = "Copy failed"; }
    setTimeout(() => (b.textContent = "Copy citation"), 2000);
  });

  // Turn the stacked Manuscripts and Blogs lists into tabs. Without JavaScript they stay stacked.
  const wrap = document.querySelector<HTMLElement>(".tabs-wrap");
  const tablist = wrap?.querySelector<HTMLElement>('[role="tablist"]');
  if (wrap && tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute("aria-controls")!)!.hidden = !on;
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => { select(t); history.replaceState(null, "", "#" + t.getAttribute("aria-controls")); });
      t.addEventListener("keydown", (e) => {
        const next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select(tabs[(next + tabs.length) % tabs.length], true);
      });
    });
    document.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((p) => (p.tabIndex = 0));
    tablist.hidden = false;
    wrap.classList.add("tabs-ready");
    const fromHash = () => tabs.find((t) => "#" + t.getAttribute("aria-controls") === location.hash);
    select(fromHash() ?? tabs[0]);
    window.addEventListener("hashchange", () => { const t = fromHash(); if (t) select(t); });
  }
</script>
