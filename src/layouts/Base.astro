---
import "../styles/global.css";
import { nav, footerLinks } from "../lib/nav";
import { url } from "../lib/data";

interface Props { title?: string; description?: string }
const { title, description = "The Mondo Disease Ontology harmonizes disease definitions across the world. Open, community-driven and free to use." } = Astro.props;
const fullTitle = title ? `${title} | Mondo Disease Ontology` : "Mondo Disease Ontology";
const here = Astro.url.pathname.replace(/\/?$/, "/");
const isCurrent = (href?: string) => !!href && url(href) === here;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#008c99" />
    <link rel="icon" type="image/png" href={url("/img/mondo_logo_black-stacked.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url("/img/mondo_logo_black-banner.png"), Astro.site).href} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Courier+Prime&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={url("/")} aria-label="Mondo home">
          <img src={url("/img/mondo_logo_black-banner.png")} alt="Mondo: the world's disease concepts, unified" width="92" height="38" />
        </a>
        <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <nav aria-label="Main">
          <ul class="nav">
            {nav.map((item) =>
              item.children ? (
                <li class={item.children.some((c) => isCurrent(c.href)) ? "has-current" : ""}>
                  <button aria-expanded="false" aria-haspopup="true">
                    {item.label}
                    <svg class="caret" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M1 3l4 4 4-4z" /></svg>
                  </button>
                  <ul class="dropdown">
                    {item.children.map((c) => (
                      <li>
                        <a href={url(c.href)} aria-current={isCurrent(c.href) ? "page" : undefined}>
                          {c.label}
                          {c.blurb && <span class="blurb">{c.blurb}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li><a href={url(item.href!)} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
              )
            )}
            <li class="gh-link">
              <a href="https://github.com/monarch-initiative/mondo" aria-label="Mondo on GitHub">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <img src={url("/img/mondo_logo_black-banner.png")} alt="Mondo" width="106" height="44" />
            <p>Mondo is part of the <a href="https://monarchinitiative.org/">Monarch Initiative</a>. Questions? Email <a href="mailto:info@monarchinitiative.org">info@monarchinitiative.org</a>.</p>
          </div>
          {footerLinks.map((col) => (
            <nav aria-labelledby={`footer-${col.heading.replace(/\W+/g, "-").toLowerCase()}`}>
              <h2 id={`footer-${col.heading.replace(/\W+/g, "-").toLowerCase()}`}>{col.heading}</h2>
              <ul>{col.links.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}</ul>
            </nav>
          ))}
        </div>
        <div class="footer-bottom">
          <span>© {year} Mondo Disease Ontology. Mondo content is licensed <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</span>
        </div>
      </div>
    </footer>

    <script>
      const header = document.querySelector(".site-header")!;
      const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle")!;
      toggle.addEventListener("click", () => {
        const open = header.classList.toggle("menu-open");
        toggle.setAttribute("aria-expanded", String(open));
      });
      header.querySelectorAll<HTMLButtonElement>(".nav > li > button").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const li = btn.parentElement!;
          const open = !li.classList.contains("open");
          header.querySelectorAll(".nav > li.open").forEach((o) => { o.classList.remove("open"); o.querySelector("button")?.setAttribute("aria-expanded", "false"); });
          li.classList.toggle("open", open);
          btn.setAttribute("aria-expanded", String(open));
        });
      });
      document.addEventListener("click", () => header.querySelectorAll(".nav > li.open").forEach((o) => o.classList.remove("open")));
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") header.querySelectorAll(".nav > li.open").forEach((o) => o.classList.remove("open")); });
    </script>
  </body>
</html>
