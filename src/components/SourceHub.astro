---
// Ring diagram: every resource Mondo integrates or aligns with, around the Mondo logo.
import { loadYaml, url } from "../lib/data";
interface Source { name: string; prefix: string; role: string; url: string; historic?: boolean }
const sources = loadYaml<Source[]>("sources.yaml");
const S = 560, C = S / 2, R_IN = 150, R_OUT = 236;
// Sources sit on the inner ring, cross-references and linkouts on the outer ring.
const place = (list: Source[], r: number, offset: number) =>
  list.map((s, i) => {
    const a = (i / list.length) * Math.PI * 2 - Math.PI / 2 + offset;
    const label = s.prefix.split(",")[0].trim().replace("icd11.foundation", "ICD-11");
    return { ...s, label, x: C + Math.cos(a) * r, y: C + Math.sin(a) * r, isSource: s.role === "Source" };
  });
const inner = sources.filter((s) => s.role === "Source");
const outer = sources.filter((s) => s.role !== "Source");
const items = [...place(outer, R_OUT, Math.PI / outer.length), ...place(inner, R_IN, 0)];
const R = R_OUT;
---
<figure class="hub">
  <svg viewBox={`0 0 ${S} ${S}`} role="img" aria-labelledby="hub-title hub-desc">
    <title id="hub-title">Resources integrated into Mondo</title>
    <desc id="hub-desc">{`Mondo sits at the center of ${sources.length} disease resources. ${items.filter((i) => i.isSource).length} are sources merged into Mondo; the rest are cross-references, alignments or linkouts.`}</desc>
    <circle cx={C} cy={C} r={R_OUT} fill="none" stroke="rgba(255,255,255,0.18)" stroke-dasharray="2 6" />
    <circle cx={C} cy={C} r={R_IN} fill="none" stroke="rgba(166,236,242,0.35)" />
    {items.map((it) => (
      <line x1={C} y1={C} x2={it.x} y2={it.y}
        stroke={it.isSource ? "#a6ecf2" : "rgba(255,255,255,0.45)"}
        stroke-width={it.isSource ? 2 : 1}
        stroke-dasharray={it.isSource ? undefined : "4 4"} class="spoke" />
    ))}
    <circle cx={C} cy={C} r="92" fill="#fff" />
    <image href={url("/img/mondo_logo_black-stacked.png")} x={C - 58} y={C - 64} width="116" height="127" />
    {items.map((it) => (
      <a href={it.url} target="_blank" rel="noopener" class="node">
        <title>{`${it.name} (${it.role}${it.historic ? ", historic" : ""})`}</title>
        <rect x={it.x - 38} y={it.y - 14} width="76" height="28" rx="14"
          fill={it.isSource ? "#a6ecf2" : "#004f57"}
          stroke={it.isSource ? "none" : "rgba(255,255,255,0.6)"} />
        <text x={it.x} y={it.y + 4.5} text-anchor="middle" font-size="12" font-weight="600"
          fill={it.isSource ? "#004f57" : "#fff"}>{it.label}</text>
      </a>
    ))}
  </svg>
  <figcaption>
    <span><i class="key src"></i>Source merged into Mondo</span>
    <span><i class="key xref"></i>Cross-reference, alignment or linkout</span>
  </figcaption>
</figure>

<style>
  .hub { margin: 0; }
  .hub svg { width: 100%; height: auto; display: block; font-family: var(--font); }
  .spoke { animation: pulse 4s ease-in-out infinite; }
  .node rect { transition: transform 0.15s; transform-box: fill-box; transform-origin: center; }
  .node:hover rect { transform: scale(1.12); }
  .hub figcaption { display: flex; flex-wrap: wrap; gap: 8px 20px; justify-content: center; font-size: 0.82rem; color: #e3f6f8; margin-top: 8px; }
  .key { display: inline-block; width: 22px; height: 10px; border-radius: 5px; margin-right: 6px; vertical-align: middle; }
  .key.src { background: #a6ecf2; }
  .key.xref { background: #004f57; border: 1px dashed rgba(255,255,255,0.8); }
  @keyframes pulse { 0%, 100% { opacity: 0.55 } 50% { opacity: 1 } }
</style>
