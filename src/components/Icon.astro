};
export type IconName = keyof typeof paths;
interface Props { name: IconName; size?: number; class?: string }
const { name, size = 16, class: cls = "" } = Astro.props;
---
<svg class={`ico ico-${name} ${cls}`} width={size} height={size} viewBox="0 0 24 24" fill="none"
  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true" focusable="false" set:html={paths[name]} />
